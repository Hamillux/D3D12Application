# Git 内部と作業ツリーの改行を、利用者の core.autocrlf に依存せず統一する。
# バイナリと判定されたファイルは変換しない。
* text=auto eol=lf

# C / C++
*.c     text eol=lf
*.cc    text eol=lf
*.cpp   text eol=lf
*.cxx   text eol=lf
*.h     text eol=lf
*.hh    text eol=lf
*.hpp   text eol=lf
*.hxx   text eol=lf
*.inl   text eol=lf
*.ipp   text eol=lf
*.ixx   text eol=lf
*.cppm  text eol=lf

# HLSL
*.hlsl  text eol=lf
*.hlsli text eol=lf
*.fx    text eol=lf
*.fxh   text eol=lf

# 一般的なテキスト／設定ファイル
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.toml        text eol=lf
*.ini         text eol=lf
*.cmake       text eol=lf
CMakeLists.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# Visual Studio / MSBuild
*.sln             text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user    text eol=crlf
*.props           text eol=crlf
*.targets         text eol=crlf
*.natvis          text eol=crlf

# スクリプト
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

